# Crypto Liquidity Engine — переменные окружения
# Скопируйте в .env и заполните (не коммитить!)

# Binance API ключи (для приватных эндпоинтов: account, openOrders, myTrades — PHASE 5+)
# Для PHASE 1-2 не нужны: публичные потоки работают без ключей.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Конфигурация приложения
CLE_CONFIG=configs/default.yaml

# Для запуска без editable-установки:
PYTHONPATH=backend